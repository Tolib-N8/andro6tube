<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/videoWrap"
        android:layout_width="match_parent"
        android:layout_height="240dp">

    <FrameLayout
        android:id="@+id/videoBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_video"
        android:clickable="true"
        android:focusable="true"
        android:padding="3dp">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            app:resize_mode="fit"
            app:shutter_background_color="@android:color/black"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC000000"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/osd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_duration"
            android:padding="12dp"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:visibility="gone" />
    </FrameLayout>

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/CtrlBtn"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_ctrl_overlay"
            android:contentDescription="Назад"
            android:padding="14dp"
            android:src="@drawable/ic_back" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:textColor="@color/text2"
            android:textSize="@dimen/text_sub" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:textColor="@color/text2"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_item"
                android:focusable="true"
                android:progressDrawable="@drawable/seek_track"
                android:splitTrack="false"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="64dp"
                android:textColor="@color/text2"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrev"
                style="@style/CtrlBtn"
                android:contentDescription="prev"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/btnRew"
                style="@style/CtrlBtn"
                android:layout_marginStart="14dp"
                android:contentDescription="rewind"
                android:src="@drawable/ic_rew" />

            <ImageButton
                android:id="@+id/btnPlay"
                style="@style/CtrlBtn"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginStart="14dp"
                android:contentDescription="play"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/btnFfwd"
                style="@style/CtrlBtn"
                android:layout_marginStart="14dp"
                android:contentDescription="forward"
                android:src="@drawable/ic_ffwd" />

            <ImageButton
                android:id="@+id/btnNext"
                style="@style/CtrlBtn"
                android:layout_marginStart="14dp"
                android:contentDescription="next"
                android:src="@drawable/ic_next" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuality"
                style="@style/Btn"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnLater"
                style="@style/Btn"
                android:layout_width="0dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/later_add" />

            <Button
                android:id="@+id/btnFull"
                style="@style/Btn"
                android:layout_width="0dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="⛶ Экран" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/listHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="@string/up_next"
        android:textColor="@color/text2"
        android:textSize="16sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="12dp"
        android:scrollbars="vertical" />
</LinearLayout>
