<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

        <EditText
            android:id="@+id/query"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_h"
            android:layout_weight="1"
            android:background="@drawable/bg_edit"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text2"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/btnSearch"
            style="@style/CtrlBtn"
            android:layout_width="@dimen/btn_h"
            android:layout_height="@dimen/btn_h"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/tabSearch"
            style="@style/Btn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/tab_search" />

        <Button
            android:id="@+id/tabHistory"
            style="@style/Btn"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/tab_history" />

        <Button
            android:id="@+id/tabLater"
            style="@style/Btn"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/tab_later" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/CtrlBtn"
            android:layout_width="@dimen/btn_h"
            android:layout_height="@dimen/btn_h"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/text2"
            android:textSize="20sp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/mini"
        layout="@layout/view_mini_player" />
</LinearLayout>
