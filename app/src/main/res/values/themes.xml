<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.A6" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorPrimaryDark">@android:color/black</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:alertDialogTheme">@style/Dialog.A6</item>
    </style>

    <style name="Dialog.A6" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/focus</item>
        <item name="android:textSize">20sp</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <!-- Крупная кнопка с яркой рамкой фокуса -->
    <style name="Btn">
        <item name="android:layout_height">@dimen/btn_h</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="CtrlBtn">
        <item name="android:layout_width">@dimen/ctrl</item>
        <item name="android:layout_height">@dimen/ctrl</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_ctrl</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
