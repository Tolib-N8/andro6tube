<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus_bg" /><stroke android:width="3dp" android:color="@color/focus" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#26FFFFFF" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#1FFFFFFF" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
