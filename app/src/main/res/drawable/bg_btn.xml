<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus_bg" /><stroke android:width="3dp" android:color="@color/focus" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#3A3A3A" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/text" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface2" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
